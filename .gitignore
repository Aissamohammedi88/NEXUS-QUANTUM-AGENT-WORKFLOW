.env
.env.*
!.env.example
*.env.local
secrets.yml
secrets.yaml
credentials.json
service-account*.json
kaggle.json
.kaggle/
config.toml
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
.npmrc
.pypirc
.netrc
auth.json
token.json
*.token

